## ----------------------------------------------------------------------------
## nexus | nexus_NextPrecdr.config.mac
##
## Configuration macro to simulate individual particles
## in a cylindrical xenon volume with copper shell (NextPrecdr).
##
## The NEXT Collaboration
## ----------------------------------------------------------------------------

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/process/em/verbose 0

/control/execute macros/geometries/NextPrecdr.mac


#/Generator/SingleParticle/particle gamma
#/Generator/SingleParticle/min_energy 2614.5 keV
#/Generator/SingleParticle/max_energy 2614.5 keV
#/Generator/SingleParticle/region SURFACE

#/Generator/Decay0Interface/inputFile none
#/Generator/Decay0Interface/Xe136DecayMode 1
#/Generator/Decay0Interface/Ba136FinalState 0
#/Generator/Decay0Interface/EnergyThreshold 1 keV
#/Generator/Decay0Interface/region VOLUME

/Generator/IonGenerator/atomic_number 83
/Generator/IonGenerator/mass_number 214
/Generator/IonGenerator/region COPPER_ENDCAPS

#/Generator/ElecPositronPair/min_energy 2457.8 keV
#/Generator/ElecPositronPair/max_energy 2457.8 keV
#/Generator/ElecPositronPair/region ACTIVE


##### ACTIONS #####
/Actions/DefaultEventAction/min_energy 2300 keV
/Actions/DefaultEventAction/max_energy 2700 keV


/nexus/persistency/output_file bi214_copper_endcaps.next
/nexus/persistency/event_type background
